{
  "name": "hanlin-explorer",
  "version": "1.1.0",
  "mcpName": "io.github.yushilinGithub/hanlin-explorer",
  "description": "MCP server for exploring the Hanlin codebase. STDIO, HTTP, and SSE transports.",
  "repository": {
    "type": "git",
    "url": "https://github.com/yushilinGithub/hanlin.git"
  },
  "homepage": "https://github.com/yushilinGithub/hanlin#readme",
  "bugs": {
    "url": "https://github.com/yushilinGithub/hanlin/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hanlin-explorer": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "npx tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.api.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
